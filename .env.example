# ==========================================
# SERVER & APP CONFIGURATION
# ==========================================
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ==========================================
# DATABASE (Choose One)
# ==========================================
# 1. For Docker Internal MongoDB Container (default):
# MONGO_URI=mongodb://mongo:27017/CollegeEventSphere

# 2. Or for MongoDB Atlas Cloud:
MONGO_URI=mongodb+srv://your_db_user:your_password@cluster0.example.mongodb.net/CollegeEventSphere

# ==========================================
# AUTHENTICATION & SECURITY
# ==========================================
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# ==========================================
# FRONTEND API ROUTING (Relative path for Nginx reverse proxy)
# ==========================================
VITE_API_URL=/api
VITE_API_BASE_URL=/api
REACT_APP_API_URL=/api

# ==========================================
# CLOUDINARY MEDIA STORAGE
# ==========================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==========================================
# NODEMAILER (GMAIL SMTP)
# ==========================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password
MAIL_FROM="EventSphere <your_email@gmail.com>"

# ==========================================
# GOOGLE GEMINI AI
# ==========================================
GEMINI_API_KEY=your_gemini_api_key
